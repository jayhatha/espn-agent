NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# Auth mode — set to true for local single-user development (bypasses JWT)
# Remove or set to false when running multi-user mode with real JWT auth
SINGLE_USER_MODE=true

# Database
DATABASE_URL=postgresql://localhost:5432/espn_fantasy

# Redis
REDIS_URL=redis://localhost:6379

# Logging
LOG_LEVEL=info

# OpenAI API key for draft narrator LLM calls
OPENAI_API_KEY=
